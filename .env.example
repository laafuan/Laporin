APP_NAME=Laporin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Identitas sekolah (tampil di halaman masuk dan nota persetujuan)
SCHOOL_NAME="SMKN 5 Surakarta"
SCHOOL_CITY=Surakarta

# Lupa kata sandi lewat email.
# MAIL_MAILER=log (bawaan): permintaan diteruskan ke admin, lalu admin mengirim kata sandi baru lewat tombol email.
# Otomatis lewat Gmail: ganti dengan pengaturan di bawahnya (MAIL_PASSWORD = "Sandi Aplikasi" Google, bukan sandi Gmail biasa).
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=akun.sekolah@gmail.com
# MAIL_PASSWORD=sandi-aplikasi-16-huruf
MAIL_FROM_ADDRESS="laporin@example.com"
MAIL_FROM_NAME="Laporin"

# Masuk/daftar dengan akun Google (opsional).
# Isi lewat menu admin: Profil -> "Masuk dengan Google" (disimpan terenkripsi di database),
# atau langsung di sini. Buat kredensial di console.cloud.google.com:
# Credentials -> Create credentials -> OAuth client ID -> tipe "Web application".
# Authorized redirect URI harus sama persis dengan GOOGLE_REDIRECT_URI di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (bawaan, tanpa instalasi tambahan)
DB_CONNECTION=sqlite

# Untuk MySQL (mis. XAMPP), ganti baris di atas dengan:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laporin
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
